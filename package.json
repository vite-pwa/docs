{
  "name": "vite-pwa-docs",
  "type": "module",
  "version": "1.2.0",
  "packageManager": "pnpm@10.18.2",
  "description": "PWA Ecosystem Documentation",
  "author": "antfu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/vite-pwa/docs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-pwa/docs.git"
  },
  "bugs": "https://github.com/vite-pwa/docs/issues",
  "keywords": [
    "react",
    "pwa",
    "vue",
    "vitepress",
    "preact",
    "svelte",
    "sveltekit",
    "workbox",
    "solidjs",
    "vite",
    "vite-plugin",
    "astro",
    "astro-integration",
    "iles",
    "nuxt",
    "nuxt module"
  ],
  "scripts": {
    "gen-workbox-api": "node gen-workbox-api-pages.ts",
    "dev": "pnpm gen-workbox-api && vitepress dev",
    "build": "pnpm gen-workbox-api && vitepress build",
    "preview": "nr build && vitepress serve",
    "https": "nr build && serve .vitepress/dist",
    "lint": "eslint .",
    "lint:fix": "nr lint --fix",
    "generate-pwa-icons": "pwa-assets-generator"
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "@vueuse/shared": "^15.0.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@antfu/ni": "^30.6.0",
    "@types/node": "^22.9.3",
    "@unplugin-pwa/core": "https://pkg.pr.new/@unplugin-pwa/core@0bae7ec",
    "@unplugin-pwa/inspector": "https://pkg.pr.new/@unplugin-pwa/inspector@0bae7ec",
    "@unplugin-pwa/types": "https://pkg.pr.new/@unplugin-pwa/types@0bae7ec",
    "@unplugin-pwa/vite": "https://pkg.pr.new/@unplugin-pwa/vite@0bae7ec",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vite-pwa/workbox-build": "^8.0.11",
    "@vite-pwa/workbox-swkit": "^8.0.11",
    "@vite-pwa/workbox-types": "^8.0.11",
    "@vite-pwa/workbox-window": "^8.0.11",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vueuse/core": "^15.0.0",
    "eslint": "^10.12.0",
    "https-localhost": "^4.7.2",
    "magicast": "^0.5.5",
    "typescript": "~6.0.3",
    "unocss": "^66.11.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.4",
    "vitepress": "https://pkg.pr.new/vitepress@16c020d",
    "vitepress-plugin-group-icons": "^1.7.7",
    "vitepress-plugin-llms": "^1.14.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@algolia/client-search"
      ]
    },
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
